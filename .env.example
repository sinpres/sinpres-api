DATABASE_URL=postgresql://sinpres:sinpres@localhost:5438/sinpres
PORT=3000
NODE_ENV=development
POSTGRES_POOL_MAX=5
POSTGRES_IDLE_TIMEOUT_SECONDS=5
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_MAX_LIFETIME_SECONDS=1800
POSTGRES_STATEMENT_TIMEOUT_MS=10000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret the web panel presents (Bearer) to reach /admin/clients.
# Required in production. Generate with: openssl rand -base64 48
ADMIN_API_SECRET=

# Only read by `bun run db:seed:admin` to create/reset an internal operator.
ADMIN_EMAIL=
ADMIN_PASSWORD=

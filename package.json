{
  "name": "sinpres-api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "bun drizzle-kit generate",
    "db:migrate": "bun drizzle-kit migrate",
    "db:seed": "bun run src/db/seed/seed.ts",
    "import:month": "./scripts/import-month.sh",
    "vercel-build": "bun build src/vercel.ts --target=node --outfile=api/index.mjs --external postgres",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/zod-openapi": "^1.2.3",
    "@scalar/hono-api-reference": "^0.10.5",
    "@vercel/blob": "^2.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.9",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  }
}
